# Copy this file to .streamlit/secrets.toml and paste your real keys.
# secrets.toml is listed in .gitignore, so it is never uploaded to GitHub.
# On Streamlit Cloud, paste these same lines into: App settings -> Secrets.

GEMINI_API_KEY = "paste-your-gemini-key-here"
TAVILY_API_KEY = "paste-your-tavily-key-here"

# Optional: force a specific Gemini model (otherwise the newest available Flash model is used)
# GEMINI_MODEL = "gemini-flash-latest"
